# Copiar a .env.local (desarrollo). NUNCA subir valores reales a Git.
# BD local Docker (ed_dev). En producción: Supabase Transaction Pooler (puerto 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ed_dev

# URL canónica de la app (usada para cookies __Host- en HTTPS y validación Origin/CSRF)
APP_URL=http://localhost:3000

# Secreto HMAC para OTP y hashes de rate limit (mín. 32 chars aleatorios en producción)
OTP_PEPPER=

# Opcional en desarrollo local (sin API key los OTP se muestran en la consola del servidor)
RESEND_API_KEY=
EMAIL_FROM=Escuela Dominical 5ta ACyM <iglesia@5acym.cl>

# Super Admin inicial (usado por `npm run db:seed`)
SEED_ADMIN_RUT=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_CLASS_NAME=Primera Clase
